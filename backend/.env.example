PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_strong_jwt_secret_here

# Frontend URL (used for password reset emails)
FRONTEND_URL=https://campusparkingcgc.vercel.app

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Auth Email Service (Nodemailer SMTP)
AUTH_EMAIL_HOST=smtp.gmail.com
AUTH_EMAIL_PORT=587
AUTH_EMAIL_USER=your_gmail_address_here
AUTH_EMAIL_PASS=your_gmail_app_password_here
AUTH_EMAIL_FROM="Campus Parking <your_gmail_address_here>"
